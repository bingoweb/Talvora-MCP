<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DESIGN-SANTRAL §3: Bahnschrift (condensed headings and labels), Cascadia Mono for times and counters. -->
    <Style x:Key="Tv.Type.Display" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="LineHeight" Value="44" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Tv.Text}" />
    </Style>
    <Style x:Key="Tv.Type.Title" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Tv.Text}" />
    </Style>
    <Style x:Key="Tv.Type.Subtitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Tv.Text}" />
    </Style>
    <Style x:Key="Tv.Type.Body" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Tv.Text}" />
    </Style>
    <Style x:Key="Tv.Type.BodyStrong" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Tv.Text}" />
    </Style>
    <Style x:Key="Tv.Type.Caption" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Tv.TextFaint}" />
    </Style>
    <Style x:Key="Tv.Type.Overline" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Tv.TextMuted}" />
    </Style>
    <Style x:Key="Tv.Type.Mono" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Tv.Text}" />
    </Style>
</ResourceDictionary>
