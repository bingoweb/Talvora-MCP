<UserControl x:Class="Talvora.Tray.Views.OverviewView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Talvora.Tray.Controls"
             Background="{DynamicResource Sn.Panel}">
    <!-- SN3 (DESIGN-SANTRAL §4): the switchboard is the overview; status, actions and the latest event slip below. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="OverviewBool"/>
        <Style x:Key="SantralButton" TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontStretch" Value="Condensed"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource Sn.Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{DynamicResource Sn.PanelRaised}"
                                BorderBrush="{DynamicResource Sn.Rule}" BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource Sn.Brass}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Sn.PanelSunken}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource Sn.Focus}"/>
                                <Setter TargetName="Plate" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid Margin="16,4,24,20" MaxWidth="1600">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="430"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <controls:Switchboard x:Name="Board" Grid.Row="0"
                                  AutomationProperties.Name="Santral: hizmetler ve dış hatlar"/>
            <Grid Grid.Row="1" Margin="8,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Tv.Type.Display}"
                               Foreground="{DynamicResource Sn.Ink}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Tv.Type.Body}"
                               Foreground="{DynamicResource Sn.InkMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <!-- Counts and the check time on separate lines: a version string must never break mid-word. -->
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Tv.Type.Mono}"
                               Foreground="{DynamicResource Sn.InkMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Tv.Type.Mono}"
                               Foreground="{DynamicResource Sn.InkFaint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Yenile" Click="OnRefresh" Style="{StaticResource SantralButton}"
                                AutomationProperties.Name="Yenile"/>
                        <Button Content="Sorunu onar" Click="OnRepair" Style="{StaticResource SantralButton}"
                                AutomationProperties.Name="Sorunu onar"
                                Visibility="{Binding CanRepair, Converter={StaticResource OverviewBool}}"/>
                        <Button Content="Ayrıntılar" Click="OnDetails" Style="{StaticResource SantralButton}"
                                AutomationProperties.Name="Ayrıntılar"
                                Visibility="{Binding CanRepair, Converter={StaticResource OverviewBool}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- SN5: the latest real event as a paper slip; click opens Olaylar. -->
                <Button Grid.Column="1" Click="OnShowEvents" Cursor="Hand" Margin="24,0,0,4" VerticalAlignment="Bottom"
                        Visibility="{Binding HasLatestEvent, Converter={StaticResource OverviewBool}}"
                        AutomationProperties.Name="Son olay; olaylar sayfasını aç" FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="SlipRoot" Width="440" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform Angle="-1"/></Grid.RenderTransform>
                                <Border Background="{DynamicResource Sn.Shadow}" Margin="5,7,-5,-7" CornerRadius="2"/>
                                <Border x:Name="Paper" Background="{DynamicResource Sn.Slip}" CornerRadius="2"
                                        BorderBrush="{DynamicResource Sn.Rule}" BorderThickness="0" Padding="22,20,22,16">
                                    <ContentPresenter/>
                                </Border>
                                <Rectangle Height="2" VerticalAlignment="Top" Margin="8,6,8,0"
                                           Stroke="{DynamicResource Sn.Panel}" StrokeThickness="6"
                                           StrokeDashArray="0.01 3" StrokeDashCap="Round"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Paper" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="Paper" Property="BorderBrush" Value="{DynamicResource Sn.Focus}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel DataContext="{Binding LatestEvent}">
                        <Grid>
                            <TextBlock Text="{Binding Time}" Style="{StaticResource Tv.Type.Mono}"
                                       Foreground="{DynamicResource Sn.InkMuted}"/>
                            <TextBlock Text="{Binding Kind}" Style="{StaticResource Tv.Type.Mono}" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Sn.InkMuted}"/>
                        </Grid>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Tv.Type.Subtitle}" FontSize="21"
                                   Foreground="{DynamicResource Sn.Ink}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Service}" Style="{StaticResource Tv.Type.Body}"
                                   Foreground="{DynamicResource Sn.InkMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
        <Border Background="{DynamicResource Sn.Panel}"
                Visibility="{Binding IsLoading, Converter={StaticResource OverviewBool}}" IsHitTestVisible="False">
            <TextBlock Text="Hatlar okunuyor…" Style="{StaticResource Tv.Type.Title}" Foreground="{DynamicResource Sn.InkMuted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
