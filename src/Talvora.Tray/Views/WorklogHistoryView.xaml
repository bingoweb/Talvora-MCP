<UserControl x:Class="Talvora.Tray.Views.WorklogHistoryView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Tv.Bg}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="HistoryBool" />
        <Style x:Key="HistoryRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Tv.Text}" />
            <Setter Property="Background" Value="{DynamicResource Tv.Surface}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Tv.AccentSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Tv.Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Çalışma günlüğü" Style="{StaticResource Tv.Type.Title}" />
        <Grid Grid.Row="1" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Ara" Style="{StaticResource Tv.Type.Caption}" />
                <TextBox x:Name="HistorySearch" MinHeight="32"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Çalışma günlüğünde ara" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Proje" Style="{StaticResource Tv.Type.Caption}" />
                <ComboBox MinHeight="32" AutomationProperties.Name="Proje filtresi"
                          ItemsSource="{Binding ProjectOptions}"
                          SelectedItem="{Binding ProjectFilter, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="Yürüten" Style="{StaticResource Tv.Type.Caption}" />
                <ComboBox MinHeight="32" AutomationProperties.Name="Yürüten filtresi"
                          ItemsSource="{Binding ActorOptions}"
                          SelectedItem="{Binding ActorFilter, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="Sonuç" Style="{StaticResource Tv.Type.Caption}" />
                <ComboBox MinHeight="32" AutomationProperties.Name="Sonuç filtresi"
                          ItemsSource="{Binding OutcomeOptions}"
                          SelectedItem="{Binding OutcomeFilter, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,8,0">
                <ListBox x:Name="HistorySessions"
                         ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource HistoryRow}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Çalışma oturumları">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"
                                    BorderBrush="{DynamicResource Tv.Border}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Tv.Radius.M}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Header.ProjectName}" Style="{StaticResource Tv.Type.BodyStrong}" />
                                    <TextBlock Text="{Binding Header.ActorName}" Style="{StaticResource Tv.Type.Caption}" />
                                    <TextBlock Text="{Binding Current.Title}" Style="{StaticResource Tv.Type.Body}"
                                               TextWrapping="Wrap" Margin="0,8,0,8" />
                                    <TextBlock Text="{Binding OutcomeLabel}" Style="{StaticResource Tv.Type.BodyStrong}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding StartedLocal}" Style="{StaticResource Tv.Type.Caption}" />
                                        <TextBlock Text=" → " Style="{StaticResource Tv.Type.Caption}" />
                                        <TextBlock Text="{Binding EndedLocal}" Style="{StaticResource Tv.Type.Caption}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Totals.Steps}" Style="{StaticResource Tv.Type.Caption}" />
                                        <TextBlock Text=" adım · " Style="{StaticResource Tv.Type.Caption}" />
                                        <TextBlock Text="{Binding Totals.FilesChanged}" Style="{StaticResource Tv.Type.Caption}" />
                                        <TextBlock Text=" dosya değişti" Style="{StaticResource Tv.Type.Caption}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Henüz kayıtlı çalışma yok." Style="{StaticResource Tv.Type.Body}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsEmpty, Converter={StaticResource HistoryBool}}" />
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Converter={StaticResource HistoryBool}}">
                <Border BorderBrush="{DynamicResource Tv.Border}" BorderThickness="1"
                        Background="{DynamicResource Tv.Surface}"
                        CornerRadius="{DynamicResource Tv.Radius.L}" Padding="16">
                    <StackPanel DataContext="{Binding SelectedSession}">
                        <TextBlock Text="{Binding Header.ProjectName}" Style="{StaticResource Tv.Type.Title}" />
                        <TextBlock Text="{Binding Header.ActorName}" Style="{StaticResource Tv.Type.Body}" />
                        <TextBlock Text="{Binding Header.TaskNote}" Style="{StaticResource Tv.Type.Body}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Current.Title}" Style="{StaticResource Tv.Type.BodyStrong}"
                                   TextWrapping="Wrap" Margin="0,16,0,0" />
                        <TextBlock Text="{Binding Current.FactLine}" Style="{StaticResource Tv.Type.Body}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding OutcomeLabel}" Style="{StaticResource Tv.Type.BodyStrong}"
                                   Foreground="{DynamicResource Tv.Accent}" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding StartedLocal}" Style="{StaticResource Tv.Type.Caption}" />
                            <TextBlock Text=" → " Style="{StaticResource Tv.Type.Caption}" />
                            <TextBlock Text="{Binding EndedLocal}" Style="{StaticResource Tv.Type.Caption}" />
                        </StackPanel>
                        <TextBlock Text="Zaman çizelgesi" Style="{StaticResource Tv.Type.Subtitle}" Margin="0,24,0,8" />
                        <ItemsControl ItemsSource="{Binding TimelineRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding LocalTime}"
                                                   Style="{StaticResource Tv.Type.Mono}" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Tv.Type.Body}"
                                                   Margin="12,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Kanıtlar" Style="{StaticResource Tv.Type.Subtitle}" Margin="0,24,0,8" />
                        <TextBlock Text="{Binding Evidence.Summary}" Style="{StaticResource Tv.Type.Body}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Evidence.Result}" Style="{StaticResource Tv.Type.Body}"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Evidence.Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Tv.Type.Mono}"
                                               TextWrapping="Wrap" Margin="0,0,0,8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding Evidence.CodePreview, Mode=OneWay}" IsReadOnly="True"
                                 Visibility="{Binding HasCodePreview, Converter={StaticResource HistoryBool}}"
                                 FontFamily="Cascadia Mono,Consolas" FontSize="12.5"
                                 Background="{DynamicResource Tv.SurfaceRaised}"
                                 Foreground="{DynamicResource Tv.Text}"
                                 TextWrapping="NoWrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 MinHeight="80" MaxHeight="420"
                                 AutomationProperties.Name="Kod değişikliği kanıtı" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
