<UserControl x:Class="Talvora.Tray.Views.WorklogHistoryView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Tv.Bg}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="HistoryBool" />
        <Style x:Key="HistoryRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Tv.Text}" />
            <Setter Property="Background" Value="{DynamicResource Tv.Surface}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Tv.AccentSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Tv.Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- WL2: a session without a project says so in faint ink instead of leaving its first line empty. -->
        <Style x:Key="HistoryProject" TargetType="TextBlock" BasedOn="{StaticResource Tv.Type.BodyStrong}">
            <Setter Property="Text" Value="{Binding Header.ProjectName}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Header.ProjectName}" Value="">
                    <Setter Property="Text" Value="Proje belirsiz" />
                    <Setter Property="Foreground" Value="{DynamicResource Tv.TextFaint}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Header.ProjectName}" Value="{x:Null}">
                    <Setter Property="Text" Value="Proje belirsiz" />
                    <Setter Property="Foreground" Value="{DynamicResource Tv.TextFaint}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryProjectTitle" TargetType="TextBlock" BasedOn="{StaticResource Tv.Type.Title}">
            <Setter Property="Text" Value="{Binding Header.ProjectName}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Header.ProjectName}" Value="">
                    <Setter Property="Text" Value="Proje belirsiz" />
                    <Setter Property="Foreground" Value="{DynamicResource Tv.TextFaint}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Header.ProjectName}" Value="{x:Null}">
                    <Setter Property="Text" Value="Proje belirsiz" />
                    <Setter Property="Foreground" Value="{DynamicResource Tv.TextFaint}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- WL2: until a session is chosen the detail column says what will appear there (hidden when the list is empty). -->
        <Style x:Key="HistoryDetailHint" TargetType="TextBlock" BasedOn="{StaticResource Tv.Type.Body}">
            <Setter Property="Foreground" Value="{DynamicResource Tv.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasSelection}" Value="False" />
                        <Condition Binding="{Binding IsEmpty}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <!-- WL3: an empty optional line leaves no hole in the detail column. -->
        <Style x:Key="HistoryOptionalText" TargetType="TextBlock" BasedOn="{StaticResource Tv.Type.Body}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryOptionalCaption" TargetType="TextBlock" BasedOn="{StaticResource Tv.Type.Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- WL3: the outcome is an 8 px dot on the card's caption line. -->
        <Style x:Key="HistoryOutcomeDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource Tv.Attention}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Completed">
                    <Setter Property="Fill" Value="{DynamicResource Tv.Ready}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Failed">
                    <Setter Property="Fill" Value="{DynamicResource Tv.Offline}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Cancelled">
                    <Setter Property="Fill" Value="{DynamicResource Tv.TextMuted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- WL3: "0 dosya değişti" is never printed; the desktop card leaves zero parts out the same way. -->
        <Style x:Key="HistoryFilesPart" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Totals.FilesChanged}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryEvidenceHeading" TargetType="TextBlock" BasedOn="{StaticResource Tv.Type.Subtitle}">
            <Setter Property="Margin" Value="0,24,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasEvidence}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Çalışma günlüğü" Style="{StaticResource Tv.Type.Title}" />
        <Grid Grid.Row="1" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Ara" Style="{StaticResource Tv.Type.Caption}" />
                <TextBox x:Name="HistorySearch" MinHeight="32"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Çalışma günlüğünde ara" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Proje" Style="{StaticResource Tv.Type.Caption}" />
                <ComboBox MinHeight="32" AutomationProperties.Name="Proje filtresi"
                          ItemsSource="{Binding ProjectOptions}"
                          SelectedItem="{Binding ProjectFilter, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="Yürüten" Style="{StaticResource Tv.Type.Caption}" />
                <ComboBox MinHeight="32" AutomationProperties.Name="Yürüten filtresi"
                          ItemsSource="{Binding ActorOptions}"
                          SelectedItem="{Binding ActorFilter, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="Sonuç" Style="{StaticResource Tv.Type.Caption}" />
                <ComboBox MinHeight="32" AutomationProperties.Name="Sonuç filtresi"
                          ItemsSource="{Binding OutcomeOptions}"
                          SelectedItem="{Binding OutcomeFilter, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,8,0">
                <ListBox x:Name="HistorySessions"
                         ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource HistoryRow}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Çalışma oturumları">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"
                                    BorderBrush="{DynamicResource Tv.Border}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Tv.Radius.M}" Padding="12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource HistoryProject}" />
                                    <TextBlock Text="{Binding Header.ActorName}" Style="{StaticResource Tv.Type.Caption}" />
                                    <!-- WL3 (user decision 2026-11-08 "Görev notu"): the task note leads, the last step follows. -->
                                    <TextBlock Text="{Binding ListHeadline}" Style="{StaticResource Tv.Type.Body}"
                                               TextTrimming="CharacterEllipsis" Margin="0,8,0,0"
                                               ToolTip="{Binding ListHeadline}" />
                                    <TextBlock Text="{Binding ListLastStep}" Style="{StaticResource HistoryOptionalCaption}"
                                               Foreground="{DynamicResource Tv.TextMuted}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Ellipse Style="{StaticResource HistoryOutcomeDot}" />
                                        <TextBlock Text="{Binding OutcomeLabel}" Style="{StaticResource Tv.Type.Caption}" />
                                        <TextBlock Text=" · " Style="{StaticResource Tv.Type.Caption}" />
                                        <TextBlock Text="{Binding ListTimeText}" Style="{StaticResource Tv.Type.Caption}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Totals.Steps}" Style="{StaticResource Tv.Type.Caption}" />
                                        <TextBlock Text=" adım" Style="{StaticResource Tv.Type.Caption}" />
                                        <StackPanel Style="{StaticResource HistoryFilesPart}">
                                            <TextBlock Text=" · " Style="{StaticResource Tv.Type.Caption}" />
                                            <TextBlock Text="{Binding Totals.FilesChanged}" Style="{StaticResource Tv.Type.Caption}" />
                                            <TextBlock Text=" dosya değişti" Style="{StaticResource Tv.Type.Caption}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Tv.Type.Body}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsEmpty, Converter={StaticResource HistoryBool}}" />
            </Grid>
            <TextBlock Grid.Column="1" Style="{StaticResource HistoryDetailHint}"
                       Text="Soldan bir oturum seç; adımları, kanıtları ve sonucu burada görürsün." />
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Converter={StaticResource HistoryBool}}">
                <Border BorderBrush="{DynamicResource Tv.Border}" BorderThickness="1"
                        Background="{DynamicResource Tv.Surface}"
                        CornerRadius="{DynamicResource Tv.Radius.L}" Padding="16">
                    <StackPanel DataContext="{Binding SelectedSession}">
                        <TextBlock Style="{StaticResource HistoryProjectTitle}" />
                        <TextBlock Text="{Binding Header.ActorName}" Style="{StaticResource Tv.Type.Body}" />
                        <TextBlock Text="{Binding Header.TaskNote}" Style="{StaticResource HistoryOptionalText}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Current.Title}" Style="{StaticResource Tv.Type.BodyStrong}"
                                   TextWrapping="Wrap" Margin="0,16,0,0" />
                        <TextBlock Text="{Binding Current.FactLine}" Style="{StaticResource HistoryOptionalText}" />
                        <TextBlock Text="{Binding OutcomeLabel}" Style="{StaticResource Tv.Type.BodyStrong}"
                                   Foreground="{DynamicResource Tv.Accent}" Margin="0,8,0,0" />
                        <!-- WL3 (user decision 2026-11-08 "Evet, nedeni göster"): why it ended so, and what comes next. -->
                        <TextBlock Text="{Binding Current.Outcome.PlainReason, TargetNullValue='', FallbackValue=''}"
                                   Style="{StaticResource HistoryOptionalText}" Foreground="{DynamicResource Tv.TextMuted}" />
                        <TextBlock Text="{Binding Current.Outcome.NextStep, StringFormat='Sonraki adım: {0}', TargetNullValue='', FallbackValue=''}"
                                   Style="{StaticResource HistoryOptionalCaption}" />
                        <TextBlock Text="{Binding DetailTimeText}" Style="{StaticResource Tv.Type.Caption}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="Zaman çizelgesi" Style="{StaticResource Tv.Type.Subtitle}" Margin="0,24,0,8" />
                        <ItemsControl ItemsSource="{Binding TimelineRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding LocalTime}"
                                                   Style="{StaticResource Tv.Type.Mono}" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Tv.Type.Body}"
                                                   Margin="12,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Kanıtlar" Style="{StaticResource HistoryEvidenceHeading}" />
                        <TextBlock Text="{Binding Evidence.Summary}" Style="{StaticResource HistoryOptionalText}" />
                        <TextBlock Text="{Binding Evidence.Result}" Style="{StaticResource HistoryOptionalText}" />
                        <ItemsControl ItemsSource="{Binding Evidence.Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Tv.Type.Mono}"
                                               TextWrapping="Wrap" Margin="0,0,0,8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding Evidence.CodePreview, Mode=OneWay}" IsReadOnly="True"
                                 Visibility="{Binding HasCodePreview, Converter={StaticResource HistoryBool}}"
                                 FontFamily="Cascadia Mono,Consolas" FontSize="12.5"
                                 Background="{DynamicResource Tv.SurfaceRaised}"
                                 Foreground="{DynamicResource Tv.Text}"
                                 TextWrapping="NoWrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 MinHeight="80" MaxHeight="420"
                                 AutomationProperties.Name="Kod değişikliği kanıtı" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
