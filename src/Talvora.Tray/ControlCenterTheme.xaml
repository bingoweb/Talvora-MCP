<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
    </ResourceDictionary.MergedDictionaries>

    <!-- Talvora product palette: deep neutral-navy surfaces, quiet borders, one cool accent. -->
    <Color x:Key="Talvora.Background.Color">#0D1118</Color>
    <Color x:Key="Talvora.Surface.Color">#131A24</Color>
    <Color x:Key="Talvora.SurfaceRaised.Color">#18212D</Color>
    <Color x:Key="Talvora.SurfaceHover.Color">#202B39</Color>
    <Color x:Key="Talvora.Border.Color">#283443</Color>
    <Color x:Key="Talvora.BorderStrong.Color">#3A4C62</Color>
    <Color x:Key="Talvora.TextPrimary.Color">#F6F8FB</Color>
    <Color x:Key="Talvora.TextSecondary.Color">#AAB6C7</Color>
    <Color x:Key="Talvora.TextTertiary.Color">#758399</Color>
    <Color x:Key="Talvora.Accent.Color">#74A8FF</Color>
    <Color x:Key="Talvora.AccentSoft.Color">#182A46</Color>
    <Color x:Key="Talvora.Ready.Color">#4FD39C</Color>
    <Color x:Key="Talvora.Attention.Color">#F2BB5C</Color>
    <Color x:Key="Talvora.Offline.Color">#EE6C7B</Color>

    <SolidColorBrush x:Key="Talvora.Background" Color="{StaticResource Talvora.Background.Color}" />
    <SolidColorBrush x:Key="Talvora.Surface" Color="{StaticResource Talvora.Surface.Color}" />
    <SolidColorBrush x:Key="Talvora.SurfaceRaised" Color="{StaticResource Talvora.SurfaceRaised.Color}" />
    <SolidColorBrush x:Key="Talvora.SurfaceHover" Color="{StaticResource Talvora.SurfaceHover.Color}" />
    <SolidColorBrush x:Key="Talvora.Border" Color="{StaticResource Talvora.Border.Color}" />
    <SolidColorBrush x:Key="Talvora.BorderStrong" Color="{StaticResource Talvora.BorderStrong.Color}" />
    <SolidColorBrush x:Key="Talvora.TextPrimary" Color="{StaticResource Talvora.TextPrimary.Color}" />
    <SolidColorBrush x:Key="Talvora.TextSecondary" Color="{StaticResource Talvora.TextSecondary.Color}" />
    <SolidColorBrush x:Key="Talvora.TextTertiary" Color="{StaticResource Talvora.TextTertiary.Color}" />
    <SolidColorBrush x:Key="Talvora.Accent" Color="{StaticResource Talvora.Accent.Color}" />
    <SolidColorBrush x:Key="Talvora.AccentSoft" Color="{StaticResource Talvora.AccentSoft.Color}" />
    <SolidColorBrush x:Key="Talvora.Ready" Color="{StaticResource Talvora.Ready.Color}" />
    <SolidColorBrush x:Key="Talvora.Attention" Color="{StaticResource Talvora.Attention.Color}" />
    <SolidColorBrush x:Key="Talvora.Offline" Color="{StaticResource Talvora.Offline.Color}" />

    <!-- Desktop execution-trace palette. Neutral surfaces carry hierarchy;
         cyan is the Talvora trace accent, while outcome colors remain semantic. -->
    <Color x:Key="Talvora.Notification.Surface.Color">#0A0F16</Color>
    <Color x:Key="Talvora.Notification.SurfaceRaised.Color">#101923</Color>
    <Color x:Key="Talvora.Notification.Terminal.Color">#05090E</Color>
    <Color x:Key="Talvora.Notification.Border.Color">#263547</Color>
    <Color x:Key="Talvora.Notification.BorderStrong.Color">#36506B</Color>
    <Color x:Key="Talvora.Notification.Trace.Color">#5BD8FF</Color>
    <Color x:Key="Talvora.Notification.TraceSoft.Color">#112A36</Color>
    <Color x:Key="Talvora.Notification.Success.Color">#4FE3A1</Color>
    <Color x:Key="Talvora.Notification.Warning.Color">#F4BD61</Color>
    <Color x:Key="Talvora.Notification.Danger.Color">#FF667A</Color>
    <Color x:Key="Talvora.Notification.Info.Color">#79AFFF</Color>
    <Color x:Key="Talvora.Notification.TextPrimary.Color">#F3F8FC</Color>
    <Color x:Key="Talvora.Notification.TextSecondary.Color">#B7C4D1</Color>
    <Color x:Key="Talvora.Notification.TextTertiary.Color">#788A9B</Color>
    <Color x:Key="Talvora.Notification.TerminalText.Color">#A8F7D0</Color>
    <Color x:Key="Talvora.Notification.TerminalMuted.Color">#74A0AE</Color>

    <SolidColorBrush x:Key="Talvora.Notification.Surface" Color="{StaticResource Talvora.Notification.Surface.Color}" />
    <SolidColorBrush x:Key="Talvora.Notification.SurfaceRaised" Color="{StaticResource Talvora.Notification.SurfaceRaised.Color}" />
    <SolidColorBrush x:Key="Talvora.Notification.Terminal" Color="{StaticResource Talvora.Notification.Terminal.Color}" />
    <SolidColorBrush x:Key="Talvora.Notification.Border" Color="{StaticResource Talvora.Notification.Border.Color}" />
    <SolidColorBrush x:Key="Talvora.Notification.BorderStrong" Color="{StaticResource Talvora.Notification.BorderStrong.Color}" />
    <SolidColorBrush x:Key="Talvora.Notification.Trace" Color="{StaticResource Talvora.Notification.Trace.Color}" />
    <SolidColorBrush x:Key="Talvora.Notification.TraceSoft" Color="{StaticResource Talvora.Notification.TraceSoft.Color}" />
    <SolidColorBrush x:Key="Talvora.Notification.Success" Color="{StaticResource Talvora.Notification.Success.Color}" />
    <SolidColorBrush x:Key="Talvora.Notification.Warning" Color="{StaticResource Talvora.Notification.Warning.Color}" />
    <SolidColorBrush x:Key="Talvora.Notification.Danger" Color="{StaticResource Talvora.Notification.Danger.Color}" />
    <SolidColorBrush x:Key="Talvora.Notification.Info" Color="{StaticResource Talvora.Notification.Info.Color}" />
    <SolidColorBrush x:Key="Talvora.Notification.TextPrimary" Color="{StaticResource Talvora.Notification.TextPrimary.Color}" />
    <SolidColorBrush x:Key="Talvora.Notification.TextSecondary" Color="{StaticResource Talvora.Notification.TextSecondary.Color}" />
    <SolidColorBrush x:Key="Talvora.Notification.TextTertiary" Color="{StaticResource Talvora.Notification.TextTertiary.Color}" />
    <SolidColorBrush x:Key="Talvora.Notification.TerminalText" Color="{StaticResource Talvora.Notification.TerminalText.Color}" />
    <SolidColorBrush x:Key="Talvora.Notification.TerminalMuted" Color="{StaticResource Talvora.Notification.TerminalMuted.Color}" />

    <!-- WPF-UI 4.3.0 Primary buttons resolve these DynamicResource keys
         from the control template. Override that exact surface so Talvora
         owns normal, hover, pressed and foreground states consistently. -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#74A8FF" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#82B2FF" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#6398EE" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0D1118" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0D1118" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#18212D" />

    <Style x:Key="TalvoraCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Talvora.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Talvora.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="TalvoraSubtleCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Talvora.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Talvora.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style
        x:Key="TalvoraSecondaryButtonStyle"
        TargetType="{x:Type ui:Button}"
        BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Secondary" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style
        x:Key="TalvoraPrimaryButtonStyle"
        TargetType="{x:Type ui:Button}"
        BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Primary" />
        <Setter Property="Background" Value="{StaticResource Talvora.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Talvora.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Talvora.Background}" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="15,7" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style
        x:Key="TalvoraGhostButtonStyle"
        TargetType="{x:Type ui:Button}"
        BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style
        x:Key="TalvoraSearchBoxStyle"
        TargetType="{x:Type ui:TextBox}"
        BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource Talvora.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Talvora.BorderStrong}" />
        <Setter Property="Foreground" Value="{StaticResource Talvora.TextPrimary}" />
    </Style>

    <Style
        x:Key="TalvoraFilterComboBoxStyle"
        TargetType="{x:Type ComboBox}"
        BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinWidth" Value="184" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource Talvora.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Talvora.BorderStrong}" />
        <Setter Property="Foreground" Value="{StaticResource Talvora.TextPrimary}" />
    </Style>

    <Style x:Key="TalvoraSectionLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Talvora.TextSecondary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
</ResourceDictionary>