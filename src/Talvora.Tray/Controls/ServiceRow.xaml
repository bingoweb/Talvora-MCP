<UserControl x:Class="Talvora.Tray.Controls.ServiceRow" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Talvora.Tray.Controls"
             Background="Transparent">
    <!-- SN6: a "hat kartı" (DESIGN-SANTRAL §7): brass socket with the service's own logo in its hole. -->
    <Border Background="{DynamicResource Sn.PanelRaised}"
            BorderBrush="{DynamicResource Sn.Rule}" BorderThickness="1"
            CornerRadius="4" Padding="8" MinHeight="60">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>
            <Grid Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Ellipse>
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.35,0.3">
                            <GradientStop Color="{DynamicResource Sn.BrassLight.Color}" Offset="0"/>
                            <GradientStop Color="{DynamicResource Sn.Brass.Color}" Offset="0.6"/>
                            <GradientStop Color="{DynamicResource Sn.BrassDark.Color}" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="26" Height="26" Fill="{DynamicResource Sn.Socket}"/>
                <Image Source="{Binding Logo}" Width="18" Height="18" Stretch="Uniform"
                       AutomationProperties.Name="{Binding Name}"/>
            </Grid>
            <TextBlock Grid.Column="1" Text="{Binding Name}"
                       Style="{StaticResource Tv.Type.BodyStrong}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" Text="{Binding Role}" Style="{StaticResource Tv.Type.Mono}"
                       Foreground="{DynamicResource Sn.InkMuted}" VerticalAlignment="Center" Margin="8,0"/>
            <controls:StatusPill Grid.Column="3" State="{Binding State}"
                                 VerticalAlignment="Center" Margin="8,0"/>
            <TextBlock Grid.Column="4" Text="{Binding LastChecked}"
                       ToolTip="{Binding CheckedTooltip}" Style="{StaticResource Tv.Type.Caption}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Button x:Name="MoreButton" Grid.Column="5" Content="⋯"
                    MinWidth="32" MinHeight="32" Background="Transparent"
                    BorderThickness="0" Click="OnMore"
                    AutomationProperties.Name="Hizmet işlemleri">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                       RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Ayrıntılar" Click="OnDetails"/>
                        <Separator/>
                        <MenuItem Header="Başlat" IsEnabled="{Binding CanStart}" Click="OnStart"/>
                        <MenuItem Header="Yeniden başlat" IsEnabled="{Binding CanRestart}" Click="OnRestart"/>
                        <MenuItem Header="Durdur" IsEnabled="{Binding CanStop}" Click="OnStop"/>
                        <MenuItem Header="Onar" IsEnabled="{Binding CanRepair}" Click="OnRepair"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>
    </Border>
</UserControl>
