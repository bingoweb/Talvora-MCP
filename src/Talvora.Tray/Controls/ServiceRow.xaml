<UserControl x:Class="Talvora.Tray.Controls.ServiceRow" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Talvora.Tray.Controls"
             Background="Transparent">
    <Border Background="{DynamicResource Tv.SurfaceRaised}"
            BorderBrush="{DynamicResource Tv.Border}" BorderThickness="1"
            CornerRadius="{StaticResource Tv.Radius.M}" Padding="8" MinHeight="56">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>
            <Image Source="{Binding Logo}" Width="32" Height="32" Stretch="Uniform"
                   VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}"
                       Style="{StaticResource Tv.Type.BodyStrong}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Border Grid.Column="2" Background="{DynamicResource Tv.Surface}"
                    CornerRadius="{StaticResource Tv.Radius.S}" Padding="8,3"
                    VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="{Binding Role}" Style="{StaticResource Tv.Type.Caption}"/>
            </Border>
            <controls:StatusPill Grid.Column="3" State="{Binding State}"
                                 VerticalAlignment="Center" Margin="8,0"/>
            <TextBlock Grid.Column="4" Text="{Binding LastChecked}"
                       ToolTip="{Binding CheckedTooltip}" Style="{StaticResource Tv.Type.Caption}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Button x:Name="MoreButton" Grid.Column="5" Content="⋯"
                    MinWidth="32" MinHeight="32" Background="Transparent"
                    BorderThickness="0" Click="OnMore"
                    AutomationProperties.Name="Hizmet işlemleri">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                       RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Ayrıntılar" Click="OnDetails"/>
                        <Separator/>
                        <MenuItem Header="Başlat" IsEnabled="{Binding CanStart}" Click="OnStart"/>
                        <MenuItem Header="Yeniden başlat" IsEnabled="{Binding CanRestart}" Click="OnRestart"/>
                        <MenuItem Header="Durdur" IsEnabled="{Binding CanStop}" Click="OnStop"/>
                        <MenuItem Header="Onar" IsEnabled="{Binding CanRepair}" Click="OnRepair"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>
    </Border>
</UserControl>
