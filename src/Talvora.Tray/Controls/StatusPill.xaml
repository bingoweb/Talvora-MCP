<UserControl x:Class="Talvora.Tray.Controls.StatusPill" x:ClassModifier="internal"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="PillBackground" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Tv.Neutral.Soft}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State, ElementName=Root}" Value="Ready">
                    <Setter Property="Background" Value="{DynamicResource Tv.Ready.Soft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State, ElementName=Root}" Value="Attention">
                    <Setter Property="Background" Value="{DynamicResource Tv.Attention.Soft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State, ElementName=Root}" Value="Offline">
                    <Setter Property="Background" Value="{DynamicResource Tv.Offline.Soft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State, ElementName=Root}" Value="Repairing">
                    <Setter Property="Background" Value="{DynamicResource Tv.Repairing.Soft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PillForeground" TargetType="TextBlock"
               BasedOn="{StaticResource Tv.Type.Caption}">
            <Setter Property="Foreground" Value="{DynamicResource Tv.Neutral}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State, ElementName=Root}" Value="Ready">
                    <Setter Property="Foreground" Value="{DynamicResource Tv.Ready}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State, ElementName=Root}" Value="Attention">
                    <Setter Property="Foreground" Value="{DynamicResource Tv.Attention}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State, ElementName=Root}" Value="Offline">
                    <Setter Property="Foreground" Value="{DynamicResource Tv.Offline}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State, ElementName=Root}" Value="Repairing">
                    <Setter Property="Foreground" Value="{DynamicResource Tv.Repairing}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource PillBackground}"
            CornerRadius="{StaticResource Tv.Radius.S}" Padding="8,3"
            HorizontalAlignment="Left" VerticalAlignment="Center">
        <TextBlock Text="{Binding DisplayText, ElementName=Root}"
                   Style="{StaticResource PillForeground}"
                   AutomationProperties.Name="{Binding DisplayText, ElementName=Root}" />
    </Border>
</UserControl>
