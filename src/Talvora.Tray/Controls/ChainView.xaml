<UserControl x:Class="Talvora.Tray.Controls.ChainView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="ChainFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource Tv.Accent}" BorderThickness="2"
                                CornerRadius="{StaticResource Tv.Radius.S}" Margin="-2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChainNodeDot" TargetType="Ellipse">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Stroke" Value="{DynamicResource Tv.Neutral}"/>
            <Setter Property="Fill" Value="{DynamicResource Tv.Neutral}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Ready">
                    <Setter Property="Stroke" Value="{DynamicResource Tv.Ready}"/>
                    <Setter Property="Fill" Value="{DynamicResource Tv.Ready}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Attention">
                    <Setter Property="Stroke" Value="{DynamicResource Tv.Attention}"/>
                    <Setter Property="Fill" Value="{DynamicResource Tv.Attention}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Offline">
                    <Setter Property="Stroke" Value="{DynamicResource Tv.Offline}"/>
                    <Setter Property="Fill" Value="{DynamicResource Tv.Offline}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Repairing">
                    <Setter Property="Stroke" Value="{DynamicResource Tv.Repairing}"/>
                    <Setter Property="Fill" Value="{DynamicResource Tv.Repairing}"/>
                </DataTrigger>
                <!-- Optional nodes stay hollow; the surface fill keeps a link from showing through the ring. -->
                <DataTrigger Binding="{Binding IsOptional}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Tv.Surface}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- §5.2 legend shapes on the nodes themselves (never colour alone, audit 16): ▲ dikkat, ✕ ulaşılamıyor,
             ↻ onarılıyor; every other state keeps the dot (hollow when optional). -->
        <Style x:Key="ChainNodeOnlyDot" TargetType="Ellipse" BasedOn="{StaticResource ChainNodeDot}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Attention">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Offline">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Repairing">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChainNodeTriangle" TargetType="Path">
            <Setter Property="Data" Value="M7,0.5 L13.6,13 L0.4,13 Z"/>
            <Setter Property="Fill" Value="{DynamicResource Tv.Attention}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Attention">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChainNodeCross" TargetType="Path">
            <Setter Property="Data" Value="M2,2 L12,12 M12,2 L2,12"/>
            <Setter Property="Stroke" Value="{DynamicResource Tv.Offline}"/>
            <Setter Property="StrokeThickness" Value="2.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Offline">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChainNodeRepairing" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE895;"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Tv.Repairing}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Repairing">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ItemsPanelTemplate x:Key="ChainCanvas">
            <Canvas IsItemsHost="True" />
        </ItemsPanelTemplate>
        <Style x:Key="ChainPlacedNode" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}"/>
            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
        </Style>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
        <Grid x:Name="Graph" Width="1100" Height="220">
            <ItemsControl ItemsSource="{Binding Links}"
                          ItemsPanel="{StaticResource ChainCanvas}"
                          IsHitTestVisible="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path Data="{Binding Geometry}"
                              Stroke="{DynamicResource Tv.Accent}" StrokeThickness="2"
                              StrokeDashArray="2 6" StrokeDashCap="Round">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFlowing}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="Flow">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset"
                                                            From="0" To="-16" Duration="0:0:1.6"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="Flow"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Nodes}"
                          ItemsPanel="{StaticResource ChainCanvas}"
                          ItemContainerStyle="{StaticResource ChainPlacedNode}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Fixed 136 x 56 box, no padding, content at the top: the dot centre is always at
                             (68, 7) from the node origin, where ChainView.xaml.cs anchors the links (audit 16). -->
                        <Button Width="136" Height="56" Padding="0" Tag="{Binding}" Click="OnNodeClick"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Top"
                                AutomationProperties.Name="{Binding Name}"
                                ToolTip="{Binding StatusLabel}" FocusVisualStyle="{StaticResource ChainFocus}"
                                Background="Transparent" BorderThickness="0">
                            <StackPanel HorizontalAlignment="Center">
                                <Grid Width="14" Height="14" HorizontalAlignment="Center">
                                    <Ellipse Style="{StaticResource ChainNodeOnlyDot}"/>
                                    <Path Style="{StaticResource ChainNodeTriangle}"/>
                                    <Path Style="{StaticResource ChainNodeCross}"/>
                                    <TextBlock Style="{StaticResource ChainNodeRepairing}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- The label hugs its text on the card surface, so a branch link passing
                                     behind it never runs through the words (audit 16). -->
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Tv.Type.Caption}"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="136" Padding="4,0"
                                           Background="{DynamicResource Tv.Surface}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Viewbox>
</UserControl>
