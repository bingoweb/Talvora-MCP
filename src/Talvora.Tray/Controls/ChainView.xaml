<UserControl x:Class="Talvora.Tray.Controls.ChainView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="ChainFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource Tv.Accent}" BorderThickness="2"
                                CornerRadius="{StaticResource Tv.Radius.S}" Margin="-2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChainNodeDot" TargetType="Ellipse">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Stroke" Value="{DynamicResource Tv.Neutral}"/>
            <Setter Property="Fill" Value="{DynamicResource Tv.Neutral}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Ready">
                    <Setter Property="Stroke" Value="{DynamicResource Tv.Ready}"/>
                    <Setter Property="Fill" Value="{DynamicResource Tv.Ready}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Attention">
                    <Setter Property="Stroke" Value="{DynamicResource Tv.Attention}"/>
                    <Setter Property="Fill" Value="{DynamicResource Tv.Attention}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Offline">
                    <Setter Property="Stroke" Value="{DynamicResource Tv.Offline}"/>
                    <Setter Property="Fill" Value="{DynamicResource Tv.Offline}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Repairing">
                    <Setter Property="Stroke" Value="{DynamicResource Tv.Repairing}"/>
                    <Setter Property="Fill" Value="{DynamicResource Tv.Repairing}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOptional}" Value="True">
                    <Setter Property="Fill" Value="Transparent"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ItemsPanelTemplate x:Key="ChainCanvas">
            <Canvas IsItemsHost="True" />
        </ItemsPanelTemplate>
        <Style x:Key="ChainPlacedNode" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}"/>
            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
        </Style>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
        <Grid x:Name="Graph" Width="1100" Height="220">
            <ItemsControl ItemsSource="{Binding Links}"
                          ItemsPanel="{StaticResource ChainCanvas}"
                          IsHitTestVisible="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Path Data="{Binding Geometry}"
                              Stroke="{DynamicResource Tv.Accent}" StrokeThickness="2"
                              StrokeDashArray="2 6" StrokeDashCap="Round">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFlowing}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="Flow">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset"
                                                            From="0" To="-16" Duration="0:0:1.6"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="Flow"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Nodes}"
                          ItemsPanel="{StaticResource ChainCanvas}"
                          ItemContainerStyle="{StaticResource ChainPlacedNode}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button MinWidth="132" MinHeight="56" Tag="{Binding}" Click="OnNodeClick"
                                AutomationProperties.Name="{Binding Name}"
                                ToolTip="{Binding StatusLabel}" FocusVisualStyle="{StaticResource ChainFocus}"
                                Background="Transparent" BorderThickness="0">
                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Style="{StaticResource ChainNodeDot}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Tv.Type.Caption}"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,8,0,0" Width="136" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Viewbox>
</UserControl>
