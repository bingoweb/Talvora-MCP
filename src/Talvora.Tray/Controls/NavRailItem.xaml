<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:local="clr-namespace:Talvora.Tray.Controls">
    <Style x:Key="ShellFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value><ControlTemplate>
                <Border BorderThickness="2" BorderBrush="{DynamicResource Tv.Accent}"
                        CornerRadius="{DynamicResource Tv.Radius.M}" Margin="-2" />
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type local:NavRailItem}">
        <Setter Property="GroupName" Value="ShellNavigation" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Margin" Value="12,4" />
        <Setter Property="Foreground" Value="{DynamicResource Tv.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
        <Setter Property="ToolTip" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:NavRailItem}">
                    <Grid>
                        <Border x:Name="Selection" Background="Transparent" CornerRadius="{DynamicResource Tv.Radius.M}" />
                        <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                Background="{DynamicResource Tv.Accent}" Visibility="Collapsed" />
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="{TemplateBinding Symbol}" FontSize="24"
                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                            <TextBlock x:Name="LabelText" Grid.Column="1" Text="{TemplateBinding Label}" Margin="16,0,0,0"
                                       Style="{StaticResource Tv.Type.BodyStrong}" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False"><Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="{DynamicResource Tv.SurfaceRaised}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Selection" Property="Background" Value="{DynamicResource Tv.AccentSoft}" />
                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Tv.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
