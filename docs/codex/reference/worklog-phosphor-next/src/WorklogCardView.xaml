<UserControl
    x:Class="Talvora.Tray.Worklog.WorklogCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wl="clr-namespace:Talvora.Tray.Worklog"
    x:Name="Root"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Talvora.Tray;component/Worklog/WorklogTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <wl:NullToCollapsedConverter x:Key="NullToCollapsed" />

            <Style x:Key="StateColored" TargetType="TextBlock" BasedOn="{StaticResource Wl.TextBase}">
                <Setter Property="Foreground" Value="{DynamicResource Wl.Cyan}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Succeeded">
                        <Setter Property="Foreground" Value="{DynamicResource Wl.Green}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Failed">
                        <Setter Property="Foreground" Value="{DynamicResource Wl.Red}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Cancelled">
                        <Setter Property="Foreground" Value="{DynamicResource Wl.Amber}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Waiting">
                        <Setter Property="Foreground" Value="{DynamicResource Wl.Amber}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="TimelineRowTemplate" DataType="{x:Type wl:WorklogTimelineRow}">
                <Grid Margin="0,1,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Tag" Text="{Binding Tag}" Style="{StaticResource Wl.TextBase}"
                               FontSize="11.5" TextWrapping="NoWrap" Foreground="{DynamicResource Wl.Faint}" />
                    <TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource Wl.TextBase}"
                               FontSize="11.5" TextWrapping="NoWrap" Foreground="{DynamicResource Wl.Faint}" />
                    <TextBlock x:Name="Label" Grid.Column="2" Text="{Binding Label}" Style="{StaticResource Wl.TextBase}"
                               FontSize="11.5" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Running">
                        <Setter TargetName="Tag" Property="Foreground" Value="{DynamicResource Wl.Cyan}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Succeeded">
                        <Setter TargetName="Tag" Property="Foreground" Value="{DynamicResource Wl.Green}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Failed">
                        <Setter TargetName="Tag" Property="Foreground" Value="{DynamicResource Wl.Red}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Wl.Text}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Cancelled">
                        <Setter TargetName="Tag" Property="Foreground" Value="{DynamicResource Wl.Amber}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Muted">
                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Wl.Faint}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="FileTabTemplate" DataType="{x:Type wl:DiffFileTab}">
                <StackPanel Orientation="Horizontal" Margin="0,0,14,2">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Wl.TextBase}" FontSize="11.5"
                               TextWrapping="NoWrap" Foreground="{DynamicResource Wl.Cyan}" />
                    <TextBlock Text=" +" Style="{StaticResource Wl.TextBase}" FontSize="11.5" TextWrapping="NoWrap"
                               Foreground="{DynamicResource Wl.Green}" />
                    <TextBlock Text="{Binding Added}" Style="{StaticResource Wl.TextBase}" FontSize="11.5"
                               TextWrapping="NoWrap" Foreground="{DynamicResource Wl.Green}" />
                    <TextBlock Text=" −" Style="{StaticResource Wl.TextBase}" FontSize="11.5" TextWrapping="NoWrap"
                               Foreground="{DynamicResource Wl.Red}" />
                    <TextBlock Text="{Binding Removed}" Style="{StaticResource Wl.TextBase}" FontSize="11.5"
                               TextWrapping="NoWrap" Foreground="{DynamicResource Wl.Red}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="ChangeRowTemplate" DataType="{x:Type wl:WorklogChangeRow}">
                <TextBlock Style="{StaticResource Wl.TextBase}" Margin="0,0,0,1" LineHeight="17"><Run Text="{Binding File, Mode=OneWay}" Foreground="{DynamicResource Wl.Cyan}" /><Run x:Name="Separator" Text=" › " Foreground="{DynamicResource Wl.Faint}" /><Run Text="{Binding Places, Mode=OneWay}" Foreground="{DynamicResource Wl.Text}" /></TextBlock>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasPlaces}" Value="False">
                        <Setter TargetName="Separator" Property="Text" Value="" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="AnswerLabel" TargetType="TextBlock" BasedOn="{StaticResource Wl.TextBase}">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Foreground" Value="{DynamicResource Wl.Faint}" />
                <Setter Property="Margin" Value="0,1,0,1" />
            </Style>

            <DataTemplate x:Key="DiffLineTemplate" DataType="{x:Type wl:DiffLine}">
                <Border x:Name="Row" Background="Transparent" Padding="0,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Number" Text="{Binding Number}" Style="{StaticResource Wl.TextBase}"
                                   TextAlignment="Right" Padding="0,0,8,0" TextWrapping="NoWrap"
                                   Foreground="{DynamicResource Wl.Faint}" />
                        <TextBlock x:Name="Marker" Grid.Column="1" Text="{Binding Marker}" Style="{StaticResource Wl.TextBase}"
                                   TextWrapping="NoWrap" Foreground="{DynamicResource Wl.Faint}" />
                        <TextBlock x:Name="Code" Grid.Column="2" Style="{StaticResource Wl.TextBase}"
                                   Foreground="{DynamicResource Wl.Muted}" LineHeight="17"><Run Text="{Binding Prefix, Mode=OneWay}" /><Run x:Name="Emphasis" Text="{Binding Emphasis, Mode=OneWay}" FontWeight="Bold" /><Run Text="{Binding Suffix, Mode=OneWay}" /></TextBlock>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Added">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Wl.AddedBg}" />
                        <Setter TargetName="Marker" Property="Foreground" Value="{DynamicResource Wl.Green}" />
                        <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource Wl.Green}" />
                        <Setter TargetName="Emphasis" Property="Background" Value="{DynamicResource Wl.AddedEmphasisBg}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Removed">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Wl.RemovedBg}" />
                        <Setter TargetName="Marker" Property="Foreground" Value="{DynamicResource Wl.Red}" />
                        <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource Wl.Red}" />
                        <Setter TargetName="Emphasis" Property="Background" Value="{DynamicResource Wl.RemovedEmphasisBg}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Hunk">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Wl.HunkBg}" />
                        <Setter TargetName="Marker" Property="Foreground" Value="{DynamicResource Wl.Cyan}" />
                        <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource Wl.Cyan}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="File">
                        <Setter TargetName="Row" Property="Margin" Value="0,6,0,2" />
                        <Setter TargetName="Marker" Property="Foreground" Value="{DynamicResource Wl.Cyan}" />
                        <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource Wl.Text}" />
                        <Setter TargetName="Code" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Note">
                        <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource Wl.Faint}" />
                        <Setter TargetName="Code" Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="Card"
            Background="{DynamicResource Wl.Surface}"
            BorderBrush="{DynamicResource Wl.BorderStrong}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- State line: finished cards keep a quiet 2 px line in their state colour (audit 12 polish). -->
            <Rectangle x:Name="StateLine" Grid.Row="0" Margin="10,0,10,0" Opacity="0.55"
                       Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Fill" Value="{DynamicResource Wl.Green}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                <Setter Property="Fill" Value="{DynamicResource Wl.Red}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                <Setter Property="Fill" Value="{DynamicResource Wl.Amber}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Waiting">
                                <Setter Property="Fill" Value="{DynamicResource Wl.Amber}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>

            <!-- Live line: only while running; a moving phosphor gradient. -->
            <Rectangle x:Name="LiveLine" Grid.Row="0" Margin="10,0,10,0"
                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <Rectangle.Fill>
                    <LinearGradientBrush x:Name="LiveLineBrush" StartPoint="0,0" EndPoint="1,0">
                        <LinearGradientBrush.RelativeTransform>
                            <TranslateTransform x:Name="LiveLineShift" X="-1" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Offset="0" Color="#0039FF88" />
                        <GradientStop Offset="0.45" Color="#FF39FF88" />
                        <GradientStop Offset="0.55" Color="#FF5BD8FF" />
                        <GradientStop Offset="1" Color="#005BD8FF" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <StackPanel Grid.Row="1" Margin="14,8,10,10">

                <!-- Header: prompt · actor · state · pin · close -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Prompt}" Style="{StaticResource Wl.TextBase}" FontSize="11.5"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Wl.Green}" />
                        <TextBlock Text=" · " Style="{StaticResource Wl.TextBase}" FontSize="11.5"
                                   TextWrapping="NoWrap" Foreground="{DynamicResource Wl.Faint}" />
                        <TextBlock Text="{Binding Actor}" Style="{StaticResource Wl.TextBase}" FontSize="11.5"
                                   TextWrapping="NoWrap" Foreground="{DynamicResource Wl.Muted}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,6,0">
                        <TextBlock x:Name="Spinner" Text="⠋" Style="{StaticResource Wl.TextBase}" FontSize="12"
                                   TextWrapping="NoWrap" Margin="0,0,5,0" Foreground="{DynamicResource Wl.Cyan}"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding StateLabel}" Style="{StaticResource StateColored}" FontSize="11.5" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PinButton" Style="{StaticResource Wl.IconButton}" Click="OnPinClick"
                                AutomationProperties.Name="Konumu sabitle" ToolTip="Konumu sabitle">
                            <TextBlock x:Name="PinGlyph" Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource Wl.IconButton}" Click="OnCloseClick" Margin="2,0,0,0"
                                AutomationProperties.Name="Kapat" ToolTip="Kapat">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Task line: the agent's task for this session (talvora_worklog_note, §6.2). -->
                <TextBlock Margin="0,5,0,0" Style="{StaticResource Wl.TextBase}" FontSize="11.5" LineHeight="16"
                           Visibility="{Binding TaskNote, Converter={StaticResource NullToCollapsed}}"><Run Text="# görev  " Foreground="{DynamicResource Wl.Faint}" /><Run Text="{Binding TaskNote, Mode=OneWay}" Foreground="{DynamicResource Wl.Cyan}" /></TextBlock>

                <!-- Title line: "> Title▍". The prompt sits in a 16 DIP gutter, so a wrapped title hangs at the
                     same text edge as the answers and the notice below (audit 2026-10-24 (15) polish). -->
                <Grid x:Name="TitleText" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Wl.TextBase}" FontSize="14.5" FontWeight="SemiBold" LineHeight="20"
                               TextWrapping="NoWrap"><Run x:Name="PromptMark" Text="&gt;" Foreground="{DynamicResource Wl.Cyan}" /></TextBlock>
                    <TextBlock Grid.Column="1" Style="{StaticResource Wl.TextBase}" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Wl.Text}" LineHeight="20"><Run Text="{Binding TitleMain, Mode=OneWay}" /><Run Text="{Binding TitleDetail, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource Wl.Muted}" /><Run x:Name="TypingCursor" Text="▍"><Run.Foreground><SolidColorBrush Color="#39FF88" /></Run.Foreground></Run></TextBlock>
                </Grid>

                <!-- Answers (§6.2): ne = agent's purpose, nerede = files › places, fark = real totals, sonuç = real fact. -->
                <Grid Margin="16,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ne" Style="{StaticResource AnswerLabel}"
                               Visibility="{Binding Purpose, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,1,0,1" Text="{Binding Purpose}" Style="{StaticResource Wl.TextBase}"
                               Foreground="{DynamicResource Wl.Text}" LineHeight="17"
                               Visibility="{Binding Purpose, Converter={StaticResource NullToCollapsed}}" />

                    <TextBlock Grid.Row="1" Text="nerede" Style="{StaticResource AnswerLabel}"
                               Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,1,0,1"
                                Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding ChangeRows}" ItemTemplate="{StaticResource ChangeRowTemplate}" Focusable="False" />
                        <TextBlock Text="{Binding MoreChangedFiles}" Style="{StaticResource Wl.TextBase}" FontSize="11"
                                   Foreground="{DynamicResource Wl.Faint}"
                                   Visibility="{Binding MoreChangedFiles, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="fark" Style="{StaticResource AnswerLabel}"
                               Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,1,0,1" Style="{StaticResource Wl.TextBase}" TextWrapping="NoWrap"
                               Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}"><Run Text="{Binding ChangeAdded, Mode=OneWay}" Foreground="{DynamicResource Wl.Green}" /><Run Text="{Binding ChangeRemoved, Mode=OneWay}" Foreground="{DynamicResource Wl.Red}" /><Run Text="{Binding ChangeFiles, Mode=OneWay}" Foreground="{DynamicResource Wl.Muted}" /></TextBlock>

                    <TextBlock Grid.Row="3" Text="sonuç" Style="{StaticResource AnswerLabel}"
                               Visibility="{Binding ResultLine, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,1,0,1" Text="{Binding ResultLine}" Style="{StaticResource Wl.TextBase}"
                               LineHeight="17" Visibility="{Binding ResultLine, Converter={StaticResource NullToCollapsed}}" />
                </Grid>

                <StackPanel Margin="16,6,0,0" Visibility="{Binding OutcomeReason, Converter={StaticResource NullToCollapsed}}">
                    <!-- "!" in its own 16 DIP gutter: the reason's wrapped lines hang under its first word. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="!" Style="{StaticResource Wl.TextBase}" Foreground="{DynamicResource Wl.Red}" FontWeight="Bold"
                                   LineHeight="17" TextWrapping="NoWrap" />
                        <TextBlock Grid.Column="1" Text="{Binding OutcomeReason}" Style="{StaticResource Wl.TextBase}"
                                   Foreground="{DynamicResource Wl.Text}" LineHeight="17" />
                    </Grid>
                    <TextBlock Margin="16,2,0,0" Text="{Binding OutcomeNextStep}" Style="{StaticResource Wl.TextBase}"
                               Visibility="{Binding OutcomeNextStep, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>

                <!-- Session timeline -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="── oturum " Style="{StaticResource Wl.TextBase}" FontSize="11"
                                   TextWrapping="NoWrap" Foreground="{DynamicResource Wl.Faint}" />
                        <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center" Fill="{DynamicResource Wl.Border}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Timeline}" ItemTemplate="{StaticResource TimelineRowTemplate}" Focusable="False" />
                    <TextBlock Margin="90,1,0,0" Text="{Binding MoreSteps}" Style="{StaticResource Wl.TextBase}" FontSize="11"
                               Foreground="{DynamicResource Wl.Faint}"
                               Visibility="{Binding MoreSteps, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>

                <!-- Code terminal: the vertical expansion the user loves. -->
                <Border x:Name="Terminal" Margin="0,10,0,0" Background="{DynamicResource Wl.Terminal}"
                        BorderBrush="{DynamicResource Wl.Border}" BorderThickness="1" CornerRadius="6"
                        Visibility="{Binding HasCode, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource Wl.Raised}" CornerRadius="6,6,0,0" Padding="9,5,6,5"
                                BorderBrush="{DynamicResource Wl.Border}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- No imitation window buttons: the header is a label, not a second window (audit 15). -->
                                <TextBlock Grid.Column="1" Text="{Binding CodeHeader}"
                                           Style="{StaticResource Wl.TextBase}" FontSize="11" TextWrapping="NoWrap"
                                           Foreground="{DynamicResource Wl.Faint}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Style="{StaticResource Wl.LinkButton}" Click="OnCopyClick"
                                        Content="kopyala" AutomationProperties.Name="Kodu kopyala" />
                            </Grid>
                        </Border>
                        <ItemsControl Grid.Row="1" Margin="9,6,9,2" ItemsSource="{Binding CodeFiles}"
                                      ItemTemplate="{StaticResource FileTabTemplate}" Focusable="False"
                                      Visibility="{Binding HasFileTabs, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ScrollViewer x:Name="CodeScroll" Grid.Row="2" Margin="0,2,0,6" MaxHeight="420"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CodeLines}" ItemTemplate="{StaticResource DiffLineTemplate}"
                                          Focusable="False" AutomationProperties.Name="Kod değişiklikleri" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- "ayrıntılar" (N6): technical evidence only, sunken mono panel; never repeats code. -->
                <Border x:Name="Details" Margin="0,10,0,0" Background="{DynamicResource Wl.Terminal}"
                        BorderBrush="{DynamicResource Wl.Border}" BorderThickness="1" CornerRadius="6" Padding="10,7,8,8"
                        Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Ayrıntılar">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="── teknik kayıt" Style="{StaticResource Wl.TextBase}" FontSize="11"
                                       TextWrapping="NoWrap" Foreground="{DynamicResource Wl.Faint}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource Wl.LinkButton}" Click="OnCopyDetailsClick"
                                    Content="kopyala" AutomationProperties.Name="Ayrıntıları kopyala" />
                        </Grid>
                        <ItemsControl Grid.Row="1" Margin="0,4,0,0" ItemsSource="{Binding DetailRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type wl:WorklogDetailRow}">
                                    <Grid Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Wl.TextBase}" FontSize="11.5"
                                                   TextWrapping="NoWrap" Foreground="{DynamicResource Wl.Faint}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Wl.TextBase}"
                                                   FontSize="11.5" Foreground="{DynamicResource Wl.Muted}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Footer -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Footer}" Style="{StaticResource Wl.TextBase}" FontSize="11"
                               Foreground="{DynamicResource Wl.Faint}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource Wl.LinkButton}" Click="OnDetailsClick"
                            Content="{Binding DetailsToggleText}" AutomationProperties.Name="Ayrıntılar"
                            Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </StackPanel>

            <!-- CRT scanlines, purely decorative, never hit-testable. -->
            <Rectangle x:Name="Scanlines" Grid.RowSpan="2" Fill="{DynamicResource Wl.Scanlines}" IsHitTestVisible="False"
                       RadiusX="10" RadiusY="10" />
        </Grid>
    </Border>
</UserControl>
