<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Talvora desktop worklog · "Phosphor" hacker theme (DESIGN-WORKLOG §7). Do not edit without Claude. -->
    <Color x:Key="Wl.Bg.Color">#05080A</Color>
    <Color x:Key="Wl.Surface.Color">#090E0C</Color>
    <Color x:Key="Wl.Raised.Color">#0E1611</Color>
    <Color x:Key="Wl.Terminal.Color">#030504</Color>
    <Color x:Key="Wl.Border.Color">#1A2A21</Color>
    <Color x:Key="Wl.BorderStrong.Color">#2A4536</Color>
    <Color x:Key="Wl.Text.Color">#D8FFE7</Color>
    <Color x:Key="Wl.Muted.Color">#8CB9A0</Color>
    <Color x:Key="Wl.Faint.Color">#557363</Color>
    <Color x:Key="Wl.Green.Color">#39FF88</Color>
    <Color x:Key="Wl.Cyan.Color">#5BD8FF</Color>
    <Color x:Key="Wl.Amber.Color">#FFB547</Color>
    <Color x:Key="Wl.Red.Color">#FF4D6A</Color>

    <SolidColorBrush x:Key="Wl.Bg" Color="{StaticResource Wl.Bg.Color}" />
    <SolidColorBrush x:Key="Wl.Surface" Color="{StaticResource Wl.Surface.Color}" />
    <SolidColorBrush x:Key="Wl.Raised" Color="{StaticResource Wl.Raised.Color}" />
    <SolidColorBrush x:Key="Wl.Terminal" Color="{StaticResource Wl.Terminal.Color}" />
    <SolidColorBrush x:Key="Wl.Border" Color="{StaticResource Wl.Border.Color}" />
    <SolidColorBrush x:Key="Wl.BorderStrong" Color="{StaticResource Wl.BorderStrong.Color}" />
    <SolidColorBrush x:Key="Wl.Text" Color="{StaticResource Wl.Text.Color}" />
    <SolidColorBrush x:Key="Wl.Muted" Color="{StaticResource Wl.Muted.Color}" />
    <SolidColorBrush x:Key="Wl.Faint" Color="{StaticResource Wl.Faint.Color}" />
    <SolidColorBrush x:Key="Wl.Green" Color="{StaticResource Wl.Green.Color}" />
    <SolidColorBrush x:Key="Wl.Cyan" Color="{StaticResource Wl.Cyan.Color}" />
    <SolidColorBrush x:Key="Wl.Amber" Color="{StaticResource Wl.Amber.Color}" />
    <SolidColorBrush x:Key="Wl.Red" Color="{StaticResource Wl.Red.Color}" />
    <SolidColorBrush x:Key="Wl.AddedBg" Color="#1A39FF88" />
    <SolidColorBrush x:Key="Wl.RemovedBg" Color="#1AFF4D6A" />
    <SolidColorBrush x:Key="Wl.HunkBg" Color="#125BD8FF" />

    <LinearGradientBrush x:Key="Wl.LiveLine" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#0039FF88" />
        <GradientStop Offset="0.45" Color="#FF39FF88" />
        <GradientStop Offset="0.55" Color="#FF5BD8FF" />
        <GradientStop Offset="1" Color="#005BD8FF" />
    </LinearGradientBrush>

    <!-- 1 px scanline every 3 px at very low opacity: CRT feel, never hides text. -->
    <DrawingBrush x:Key="Wl.Scanlines" TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute" Opacity="0.035">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FFFFFF">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,3,1" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <FontFamily x:Key="Wl.Mono">Cascadia Mono, Cascadia Code, Consolas</FontFamily>

    <Style x:Key="Wl.TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Wl.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Wl.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="Wl.IconButton" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Wl.Faint}" />
        <Setter Property="FontFamily" Value="{StaticResource Wl.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Wl.BorderStrong}" />
                            <Setter Property="Foreground" Value="{DynamicResource Wl.Green}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Wl.Cyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Wl.LinkButton" TargetType="Button" BasedOn="{StaticResource Wl.IconButton}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Foreground" Value="{DynamicResource Wl.Cyan}" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>
</ResourceDictionary>
